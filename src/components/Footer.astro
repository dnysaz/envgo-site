---
import config from 'virtual:starlight/user-config';
import { Icon } from '@astrojs/starlight/components';
import EditLink from 'virtual:starlight/components/EditLink';
import LastUpdated from 'virtual:starlight/components/LastUpdated';
import Pagination from 'virtual:starlight/components/Pagination';
const year = new Date().getFullYear();

// Only show the big Go-style footer on the homepage (splash).
// Docs pages get no footer at all per request: "footer cuma di homepage saja".
const pathname = Astro.url.pathname;
// Homepage on custom domain envgo.dev ("/") and legacy GitHub Pages ("/envgo-site/")
const isHomepage =
  pathname === '/' ||
  pathname === '/envgo-site/' ||
  pathname === '/envgo-site' ||
  pathname === '/envgo-site/index.html' ||
  pathname === '/index.html' ||
  Astro.locals.starlightRoute?.id === 'index' ||
  Astro.locals.starlightRoute?.entry?.slug === '' ||
  Astro.locals.starlightRoute?.entry?.id === 'index';

if (!isHomepage) {
  // For docs pages, render the minimal Starlight footer (pagination only) without the big envGo watermark.
  // To hide completely, just return empty.
}
---

{isHomepage ? (
<footer class="go-footer">
  <div class="go-footer-bg" aria-hidden="true">envGo</div>
  <div class="go-footer-inner">
    <div class="go-footer-top">
      <div class="go-footer-brand">
        <div class="go-footer-title">envGo</div>
        <p class="go-footer-desc">Zero-dependency micro-runtime for HTML. Secrets stay server-side.</p>
        <p class="go-footer-copy">© {year} Ketut Dana • MIT Licensed • No telemetry</p>
      </div>
      <nav class="go-footer-links" aria-label="Footer">
        <div>
          <div class="go-footer-heading">Docs</div>
          <a href="/getting-started/introduction/">Introduction</a>
          <a href="/getting-started/installation/">Installation</a>
          <a href="/getting-started/quick-start/">Quick Start</a>
        </div>
        <div>
          <div class="go-footer-heading">Reference</div>
          <a href="/reference/cli-commands/">CLI</a>
          <a href="/reference/configuration/">Configuration</a>
          <a href="/reference/threat-model/">Threat Model</a>
        </div>
        <div>
          <div class="go-footer-heading">Project</div>
          <a href="https://github.com/dnysaz/envgo" target="_blank" rel="noopener">GitHub</a>
          <a href="https://github.com/dnysaz/envgo/releases" target="_blank" rel="noopener">Releases</a>
          <a href="/license/">License &amp; feedback</a>
        </div>
      </nav>
    </div>
    <div class="go-footer-bottom">
      <div class="meta sl-flex">
        <EditLink />
        <LastUpdated />
      </div>
      <Pagination />
      {config.credits && (
        <a class="kudos sl-flex" href="https://starlight.astro.build">
          <Icon name={'starlight'} /> {Astro.locals.t('builtWithStarlight.label')}
        </a>
      )}
    </div>
  </div>
</footer>
) : (
<footer class="docs-footer-minimal">
  <div class="meta sl-flex">
    <EditLink />
    <LastUpdated />
  </div>
  <Pagination />
</footer>
)}

<style>
  .go-footer {
    position: relative;
    overflow: hidden;
    margin-top: 3rem;
    background: #f8fafc;
    border-top: 1px solid #e2e8f0;
    padding: 2.2rem 1.5rem 1.5rem;
    /* full-bleed like hero */
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    max-width: 100vw;
  }
  :global([data-theme="dark"]) .go-footer {
    background: #0f172a;
    border-top-color: #1e293b;
  }
  .go-footer-bg {
    position: absolute;
    left: 50%;
    bottom: -0.18em;
    transform: translateX(-50%);
    font-size: clamp(6rem, 18vw, 16rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.06em;
    color: #007d9c;
    opacity: 0.06;
    pointer-events: none;
    user-select: none;
    white-space: nowrap;
  }
  :global([data-theme="dark"]) .go-footer-bg {
    color: white;
    opacity: 0.04;
  }
  .go-footer-inner {
    position: relative;
    max-width: 1100px;
    margin: 0 auto;
  }
  .go-footer-top {
    display: grid;
    grid-template-columns: 1.2fr 1.8fr;
    gap: 2rem;
    align-items: start;
  }
  .go-footer-brand {
    max-width: 32ch;
  }
  .go-footer-title {
    font-size: 1.1rem;
    font-weight: 800;
    color: #007d9c;
    letter-spacing: -0.02em;
  }
  .go-footer-desc {
    margin: 0.4rem 0 0;
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--sl-color-gray-3);
  }
  .go-footer-copy {
    margin: 0.7rem 0 0;
    font-size: 0.78rem;
    color: var(--sl-color-gray-4);
  }
  .go-footer-links {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  .go-footer-heading {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sl-color-gray-1);
    margin-bottom: 0.6rem;
  }
  .go-footer-links a {
    display: block;
    font-size: 0.86rem;
    line-height: 1.6;
    color: var(--sl-color-gray-3);
    text-decoration: none;
  }
  .go-footer-links a:hover {
    color: #007d9c;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .go-footer-bottom {
    margin-top: 1.8rem;
    padding-top: 1.4rem;
    border-top: 1px solid #e2e8f0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  :global([data-theme="dark"]) .go-footer-bottom {
    border-top-color: #1e293b;
  }
  .go-footer-bottom :global(.meta) {
    margin-top: 0;
  }
  .go-footer-bottom :global(.kudos) {
    margin: 0 auto;
  }
  @media (max-width: 50rem) {
    .go-footer-top {
      grid-template-columns: 1fr;
    }
    .go-footer-links {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 32rem) {
    .go-footer-links {
      grid-template-columns: 1fr;
    }
  }

  /* Minimal footer for docs pages — no big watermark */
  .docs-footer-minimal {
    margin-top: 3rem;
    padding-top: 1.2rem;
    border-top: 1px solid #e2e8f0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  :global([data-theme="dark"]) .docs-footer-minimal {
    border-top-color: #1e293b;
  }
</style>
