---
import { PAGE_TITLE_ID } from '../../node_modules/@astrojs/starlight/constants';
import LinkButton from '../../node_modules/@astrojs/starlight/user-components/LinkButton.astro';
import promptTextRaw from "../../public/envgo-agent-prompt.txt?raw";

const { data } = Astro.locals.starlightRoute.entry;
const hero = data.hero || {};
let { title = data.title, tagline, image, actions = [] } = hero;

// Keep original actions (Get Started, View on GitHub) but we will render
// a native Copy AI Prompt button between them for a tidy single row.
const promptText = promptTextRaw;
---

<div class="hero">
  <div class="sl-flex stack">
    <div class="sl-flex copy">
      <div class="eyebrow">Zero-dependency • No telemetry • MIT Licensed</div>
      <h1 id={PAGE_TITLE_ID} data-page-title set:html={title} />
      {tagline && <div class="tagline" set:html={tagline} />}
      <p class="subtagline">
        Paste one prompt into your AI agent and go from <code>envgo -v</code> check → auto-install → <code>envgo run dev</code> without manual setup.
      </p>
    </div>
    <div class="sl-flex actions">
      {
        actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => {
          // Render the first action (Get Started) as primary
          if (text === "Get Started") {
            return (
              <LinkButton href={href} variant="primary" icon={icon?.name} class:list={[className]} {...attrs}>
                {text}
              </LinkButton>
            );
          }
          return null;
        })
      }
      <button id="hero-copy-prompt-btn" type="button" class="sl-link-button not-content secondary hero-copy-btn" aria-label="Copy AI prompt for envGo">
        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="--sl-icon-size:1.2rem"><path d="M7 7a1 1 0 0 1 1-1h8a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1h-1a1 1 0 0 0 0 2h1a3 3 0 0 0 3-3V7a3 3 0 0 0-3-3H8a3 3 0 0 0-3 3v1a1 1 0 1 0 2 0V7Z"/><path d="M5 11a3 3 0 0 1 3-3h8a3 3 0 0 1 3 3v8a3 3 0 0 1-3 3H8a3 3 0 0 1-3-3v-8Zm3-1a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1v-8a1 1 0 0 0-1-1H8Z"/></svg>
        <span id="hero-copy-label">Copy AI Prompt</span>
      </button>
      {
        actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => {
          if (text === "View on GitHub") {
            return (
              <LinkButton href={href} variant="minimal" icon={icon?.name} class:list={[className]} {...attrs}>
                {text}
              </LinkButton>
            );
          }
          return null;
        })
      }
    </div>
    <div class="hero-hint">
      <span id="hero-copy-status" aria-live="polite"></span>
      <span class="hero-hint-sep">·</span>
      <a href="/envgo-site/envgo-agent-prompt.txt" target="_blank" rel="noopener">View raw prompt</a>
      <span class="hero-hint-sep">·</span>
      <span>Works with Cursor, Kilo Code, Copilot, Claude &amp; more</span>
    </div>
  </div>
</div>

<textarea id="hero-prompt-source" aria-hidden="true" style="position:absolute;left:-9999px;top:-9999px;opacity:0;" readonly>{promptText}</textarea>

<style>
  .hero {
    display: grid;
    align-items: center;
    gap: 1rem;
    padding-bottom: 1rem;
  }
  .stack {
    flex-direction: column;
    gap: 1.25rem;
    text-align: center;
    align-items: center;
    max-width: 760px;
    margin-inline: auto;
  }
  .copy {
    flex-direction: column;
    gap: 0.85rem;
    align-items: center;
  }
  .copy > * {
    max-width: 58ch;
  }
  .eyebrow {
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--sl-color-gray-2);
    border: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-gray-6);
    padding: 0.28rem 0.7rem;
    border-radius: 999px;
  }
  h1 {
    font-size: clamp(var(--sl-text-3xl), calc(0.25rem + 5vw), var(--sl-text-6xl));
    line-height: var(--sl-line-height-headings);
    font-weight: 700;
    color: var(--sl-color-white);
    letter-spacing: -0.02em;
  }
  .tagline {
    font-size: clamp(var(--sl-text-base), calc(0.0625rem + 1.8vw), var(--sl-text-xl));
    color: var(--sl-color-gray-2);
    line-height: 1.45;
  }
  .subtagline {
    font-size: 0.92rem;
    color: var(--sl-color-gray-3);
    line-height: 1.55;
    max-width: 56ch;
  }
  .subtagline code {
    font-size: 0.88em;
    background: var(--sl-color-gray-6);
    padding: 0.12rem 0.35rem;
    border-radius: 6px;
    border: 1px solid var(--sl-color-gray-5);
  }
  .actions {
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
  }
  .hero-copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    cursor: pointer;
    font-weight: 600;
    border-color: var(--sl-color-gray-3) !important;
    background: var(--sl-color-white);
    color: var(--sl-color-black) !important;
  }
  .hero-copy-btn:hover {
    background: var(--sl-color-gray-7);
  }
  .hero-copy-btn.copied {
    background: #16a34a !important;
    border-color: #16a34a !important;
    color: white !important;
  }
  .hero-hint {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.6rem;
    align-items: center;
    justify-content: center;
    font-size: 0.82rem;
    color: var(--sl-color-gray-3);
  }
  .hero-hint a {
    color: var(--sl-color-gray-2);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .hero-hint-sep {
    opacity: 0.5;
  }
  #hero-copy-status {
    font-weight: 600;
    color: #16a34a;
  }
  @media (min-width: 50rem) {
    .hero {
      padding-block: clamp(2rem, calc(1rem + 6vmin), 7rem);
    }
  }
</style>

<script is:inline define:vars={{ promptText }}>
  (function () {
    function setup() {
      var btn = document.getElementById("hero-copy-prompt-btn");
      var label = document.getElementById("hero-copy-label");
      var status = document.getElementById("hero-copy-status");
      var source = document.getElementById("hero-prompt-source");
      if (!btn || !label) return;
      var original = label.textContent;
      async function copyText() {
        var text = source ? source.value : promptText;
        try {
          if (navigator.clipboard && window.isSecureContext) {
            await navigator.clipboard.writeText(text);
            return true;
          }
        } catch (e) {}
        try {
          if (source) {
            source.focus();
            source.select();
            source.setSelectionRange(0, 999999);
            var ok = document.execCommand("copy");
            window.getSelection()?.removeAllRanges();
            return ok;
          }
        } catch (e) {}
        return false;
      }
      btn.addEventListener("click", async function () {
        var ok = await copyText();
        // also trigger the card button if present to keep states in sync
        var cardBtn = document.getElementById("copy-prompt-btn");
        var cardLabel = document.getElementById("copy-prompt-label");
        var cardStatus = document.getElementById("copy-prompt-status");
        if (ok) {
          btn.classList.add("copied");
          label.textContent = "✓ Copied!";
          if (status) status.textContent = "Copied — paste into your AI agent now.";
          if (cardBtn) cardBtn.classList.add("copied");
          if (cardLabel) cardLabel.textContent = "✓ Copied!";
          if (cardStatus) cardStatus.textContent = "Copied — paste into your AI agent now.";
          setTimeout(function () {
            btn.classList.remove("copied");
            label.textContent = original;
            if (status) status.textContent = "";
            if (cardBtn) cardBtn.classList.remove("copied");
            if (cardLabel) cardLabel.textContent = "Copy AI Prompt";
            if (cardStatus) cardStatus.textContent = "";
          }, 2200);
        } else {
          if (status) status.textContent = "Copy failed — use View raw prompt.";
        }
      });
    }
    if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", setup);
    else setup();
  })();
</script>
