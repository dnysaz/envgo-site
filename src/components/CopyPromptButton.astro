---
/* Compact secondary hint below hero — English, Go.dev-like footnote style */
import promptTextRaw from "../../public/envgo-agent-prompt.txt?raw";
const promptText = promptTextRaw;
---

<div id="copy-prompt-card" class="copy-prompt-inline">
  <div class="copy-inline-main">
    <span class="copy-inline-icon" aria-hidden="true">🤖</span>
    <div class="copy-inline-text">
      <strong>Using an AI agent?</strong> Copy the prompt and paste it — the agent will handle the rest.
      <a href="/envgo-agent-prompt.txt" target="_blank" rel="noopener">View raw prompt →</a>
    </div>
    <button id="copy-prompt-btn" type="button" class="copy-inline-btn" aria-label="Copy AI prompt">
      <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M7 7a1 1 0 0 1 1-1h8a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1h-1a1 1 0 1 0 0 2h1a3 3 0 0 0 3-3V7a3 3 0 0 0-3-3H8a3 3 0 0 0-3 3v1a1 1 0 1 0 2 0V7Z"/><path d="M5 11a3 3 0 0 1 3-3h8a3 3 0 0 1 3 3v8a3 3 0 0 1-3 3H8a3 3 0 0 1-3-3v-8Zm3-1a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1v-8a1 1 0 0 0-1-1H8Z"/></svg>
      <span id="copy-prompt-label">Copy AI Prompt</span>
    </button>
    <span id="copy-prompt-status" class="copy-inline-status" aria-live="polite"></span>
  </div>
  <details class="copy-inline-details">
    <summary>What happens after you copy?</summary>
    <ol>
      <li>Paste into Cursor, Kilo Code, Copilot, Claude, etc.</li>
      <li>Agent checks <code>envgo -v</code> — installs the right binary for your OS if missing.</li>
      <li>Then <code>envgo init</code> → <code>.env</code> → <code>envgo run dev</code> and shows <code>&lt;div id="KEY"&gt;</code> + <code>{"{VAR}"}</code> usage.</li>
      <li>If stuck, it opens <a href="/getting-started/quick-start/">Quick Start</a>.</li>
    </ol>
  </details>
  <textarea id="copy-prompt-source" aria-hidden="true" style="position:absolute;left:-9999px;top:-9999px;opacity:0;" readonly>{promptText}</textarea>
</div>

<style>
  .copy-prompt-inline {
    max-width: 760px;
    margin: 1rem auto 1.4rem;
    background: var(--sl-color-gray-6);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 10px;
    padding: 0.85rem 1rem;
  }
  .copy-inline-main {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 0.75rem;
    align-items: center;
  }
  .copy-inline-icon { font-size: 1.15rem; }
  .copy-inline-text {
    flex: 1 1 280px;
    font-size: 0.88rem;
    line-height: 1.45;
    color: var(--sl-color-gray-1);
  }
  .copy-inline-text a {
    font-weight: 600;
    margin-left: 0.3rem;
  }
  .copy-inline-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--sl-color-white);
    color: var(--sl-color-black);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    padding: 0.42rem 0.9rem;
    font-weight: 600;
    font-size: 0.86rem;
    cursor: pointer;
    white-space: nowrap;
  }
  .copy-inline-btn:hover { background: var(--sl-color-gray-7); }
  .copy-inline-btn.copied { background: #007d9c; color: white; border-color: #007d9c; }
  .copy-inline-status {
    font-size: 0.8rem;
    font-weight: 600;
    color: #007d9c;
  }
  .copy-inline-details {
    margin-top: 0.65rem;
    font-size: 0.83rem;
    color: var(--sl-color-gray-2);
  }
  .copy-inline-details summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--sl-color-gray-1);
  }
  .copy-inline-details ol {
    margin: 0.45rem 0 0 1.15rem;
    line-height: 1.55;
  }
</style>

<script is:inline define:vars={{ promptText }}>
  (function () {
    function setup() {
      var btn = document.getElementById("copy-prompt-btn");
      var label = document.getElementById("copy-prompt-label");
      var status = document.getElementById("copy-prompt-status");
      var source = document.getElementById("copy-prompt-source");
      var heroBtn = document.getElementById("hero-copy-prompt-btn");
      var heroLabel = document.getElementById("hero-copy-label");
      var heroStatus = document.getElementById("hero-copy-status");
      if (!btn || !label) return;
      var orig = label.textContent;
      async function copyText() {
        var text = source ? source.value : promptText;
        try { if (navigator.clipboard && window.isSecureContext) { await navigator.clipboard.writeText(text); return true; } } catch(e){}
        try { if (source) { source.focus(); source.select(); source.setSelectionRange(0,999999); var ok=document.execCommand("copy"); window.getSelection()?.removeAllRanges(); return ok; } } catch(e){}
        return false;
      }
      btn.addEventListener("click", async function(){
        var ok = await copyText();
        if(ok){
          btn.classList.add("copied"); label.textContent="✓ Copied!"; if(status) status.textContent="Copied — paste into your agent";
          if(heroBtn) heroBtn.classList.add("copied"); if(heroLabel) heroLabel.textContent="✓ Copied!"; if(heroStatus) heroStatus.textContent="Copied — paste into your AI agent";
          setTimeout(function(){
            btn.classList.remove("copied"); label.textContent=orig; if(status) status.textContent="";
            if(heroBtn) heroBtn.classList.remove("copied"); if(heroLabel) heroLabel.textContent="Copy AI Prompt"; if(heroStatus) heroStatus.textContent="";
          },2200);
        } else { if(status) status.textContent="Copy failed — use View raw prompt"; }
      });
    }
    if(document.readyState==="loading") document.addEventListener("DOMContentLoaded",setup); else setup();
  })();
</script>
